<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.StatArchive" parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- No Android action/title bar -->
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>

        <!-- App window background -->
        <item name="android:windowBackground">@color/background_color</item>

        <!-- Android 12+ system splash -->
        <!-- Use the dedicated Stat Archive splash artwork instead of the
             adaptive launcher icon, which was producing the small logo
             inside the large white rounded square. -->
        <item name="android:windowSplashScreenBackground">@color/background_color</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/background_color</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Bottom navigation bar -->
        <item name="android:navigationBarColor">@color/background_color</item>

        <!-- Prevent translucent/floating window behaviour -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>

    </style>

</resources>
