<?xml version="1.0" encoding="utf-8"?>

<paths xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Files opened/shared from Stat Archive -->
    <cache-path
        name="shared_files"
        path="shared/" />

    <!-- Chunk-streamed files avoid one large Base64 allocation -->
    <cache-path
        name="streamed_files"
        path="streamed-files/" />

    <!-- Temporary scanner camera photos -->
    <cache-path
        name="scanner_files"
        path="scanner/" />

    <!-- Downloaded APK used for app updates -->
    <cache-path
        name="app_updates"
        path="updates/" />

</paths>
